#!/usr/bin/env bash
set -euo pipefail
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
if [ -n "${PAPERVPN_ROOT:-}" ]; then
  ROOT="$PAPERVPN_ROOT"
else
  ROOT="$(cd "$(dirname "$SELF")/../../.." 2>/dev/null && pwd || true)"
fi
if [ -n "${ROOT:-}" ] && [ -d "$ROOT/papervpn" ]; then
  exec env PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" python3 -m papervpn.mcp_server
fi
exec python3 -m papervpn.mcp_server
